# Base URL for a future HTTP catalog API (no trailing slash).
# Leave empty while the catalog is read from Sanity.
NEXT_PUBLIC_API_BASE_URL=

# Set to "true" to use in-repo mock products instead of Sanity.
NEXT_PUBLIC_USE_MOCK_API=false

NEXT_PUBLIC_SANITY_PROJECT_ID=your-project-id
NEXT_PUBLIC_SANITY_DATASET=production
